# Server
# Render injects PORT automatically; local development falls back to 5000.
PORT=5000
HOST=0.0.0.0

# Comma-separated list of browser origins allowed to call this API.
# Example: https://voicemate-ai.vercel.app,https://voicemate-ai-git-main-user.vercel.app
# localhost origins for development are always allowed.
FRONTEND_ORIGIN=http://localhost:5173

# Gnani AI (keep this server-side only — never expose it to the browser)
GNANI_API_KEY=PASTE_YOUR_GNANI_API_KEY_HERE

# Maximum time to wait for Prisma/Timbre before returning 504 (milliseconds)
GNANI_TIMEOUT_MS=90000
